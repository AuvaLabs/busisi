{
    email ops@auvalabs.com
    admin off
    servers {
        max_header_size 16KB
        timeouts {
            read_body 30s
            read_header 10s
            write 30s
            idle 2m
        }
    }
}

# ---- Production site blocks (real domains) -------------------------------
# Caddy handles HTTPS automatically via Let's Encrypt HTTP-01 (grey-cloud
# DNS at Cloudflare). Switch to orange-cloud + DNS-01 + CF API token when
# ready to enable Cloudflare proxy.

# The Embedding Report — V1 (AI/ML).
embedding.report {
    encode zstd gzip
    log {
        output file /var/log/caddy/embedding.log
        format json
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }
    handle /api/* { reverse_proxy 127.0.0.1:8001 }
    handle /r/* { reverse_proxy 127.0.0.1:8001 }
    handle /confirm { reverse_proxy 127.0.0.1:8001 }
    handle /unsubscribe { reverse_proxy 127.0.0.1:8001 }
    handle {
        root * /srv/grimoire/data/output/embedding
        file_server
    }
}

# Plural defensive — 301 redirect to the canonical singular.
embeddings.report {
    redir https://embedding.report{uri} permanent
}

# Vested — V2 (personal finance for tech workers).
vested.news {
    encode zstd gzip
    log {
        output file /var/log/caddy/vested.log
        format json
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }
    handle /api/* { reverse_proxy 127.0.0.1:8001 }
    handle /r/* { reverse_proxy 127.0.0.1:8001 }
    handle /confirm { reverse_proxy 127.0.0.1:8001 }
    handle /unsubscribe { reverse_proxy 127.0.0.1:8001 }
