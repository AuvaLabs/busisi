{
    email ops@auvalabs.com
    admin off
    servers {
        max_header_size 16KB
        timeouts {
            read_body 30s
            read_header 10s
            write 30s
            idle 2m
        }
    }
}

# Modelwatch placeholder hostname (until real domain is committed).
modelwatch.local:80 {
    root * /srv/grimoire/data/output/modelwatch
    file_server
    encode zstd gzip
    log {
        output file /var/log/caddy/modelwatch.log
        format json
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }
}

# Default catch-all (raw IP, unknown hosts).
# Browsers hitting http://178.104.214.16/ also see modelwatch (Phase 3 demo).
:80 {
    @grimoire host modelwatch.local 178.104.214.16
    handle @grimoire {
        root * /srv/grimoire/data/output/modelwatch
        file_server
    }
    handle {
        root * /srv/grimoire/caddy/sentinel/_default
        file_server
    }
    encode zstd gzip
    log {
        output file /var/log/caddy/default.log
        format json
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
