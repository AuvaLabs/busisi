    }
}

# ---- Local-dev placeholders (HTTP only, .local hostnames) ----------------
# Useful for `curl -H "Host: embedding.local" http://...` against the
# rendered output without DNS. Remove once production domains are stable.

embedding.local:80 {
    encode zstd gzip
    log {
        output file /var/log/caddy/embedding.log
        format json
    }
    header { -Server }
    handle /api/* { reverse_proxy 127.0.0.1:8001 }
    handle /r/* { reverse_proxy 127.0.0.1:8001 }
    handle /confirm { reverse_proxy 127.0.0.1:8001 }
    handle /unsubscribe { reverse_proxy 127.0.0.1:8001 }
    handle {
        root * /srv/grimoire/data/output/embedding
        file_server
    }
}

vested.local:80 {
    encode zstd gzip
    log {
        output file /var/log/caddy/vested.log
        format json
    }
    header { -Server }
    handle /api/* { reverse_proxy 127.0.0.1:8001 }
    handle /r/* { reverse_proxy 127.0.0.1:8001 }
    handle /confirm { reverse_proxy 127.0.0.1:8001 }
    handle /unsubscribe { reverse_proxy 127.0.0.1:8001 }
    handle {
