{
    email ops@auvalabs.com
    admin off
    servers {
        max_header_size 16KB
        timeouts {
            read_body 30s
            read_header 10s
            write 30s
            idle 2m
        }
    }
}

# Shared security headers — imported by every site block (prod + .local) so the
# quality harness, which audits the .local hosts, measures the same headers
# production serves. Single source of truth; edit here, applies everywhere.
(sec_headers) {
    import sec_headers
}

# ---- Production site blocks (real domains) -------------------------------
# Caddy uses a Cloudflare Origin Certificate (multi-SAN, 15-year validity)
# at /etc/ssl/grimoire/origin.{crt,key}. Cloudflare orange-cloud is in
# front of every domain — origin IP hidden, DDoS protection, edge cache,
# Web Analytics. Renewal: never (cert valid until 2041-05-01).
# CF passes the real client IP via the CF-Connecting-IP header; Caddy's
# `client_ip_headers` directive teaches it to use that for `remote_ip`
# in logs and proxy metadata, so bot_log_parser sees real bot IPs.

# The Embedding Report — V1 (AI/ML).
embedding.report {
    tls /etc/ssl/grimoire/origin.crt /etc/ssl/grimoire/origin.key
    encode zstd gzip
    log {
        output file /var/log/caddy/embedding.log
        format json
    }
    import sec_headers
    handle /api/* {
        reverse_proxy 127.0.0.1:8001 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }
    handle /r/* {
        reverse_proxy 127.0.0.1:8001 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }
    handle /confirm {
        reverse_proxy 127.0.0.1:8001 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }
    handle /unsubscribe {
        reverse_proxy 127.0.0.1:8001 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }
    handle {
        root * /srv/grimoire/data/output/embedding
        file_server
    }
}

# Plural defensive — 301 redirect to the canonical singular.
embeddings.report {
    tls /etc/ssl/grimoire/origin.crt /etc/ssl/grimoire/origin.key
    redir https://embedding.report{uri} permanent
}

# Vested — V2 (personal finance for tech workers).
