# Default catch-all (raw IP, unknown hosts).
# Browsers hitting http://178.104.214.16/ also see The Embedding Report.
:80 {
    @grimoire host embedding.local 178.104.214.16
    handle @grimoire {
        root * /srv/grimoire/data/output/embedding
        file_server
    }
    handle {
        root * /srv/grimoire/caddy/sentinel/_default
        file_server
    }
    encode zstd gzip
    log {
        output file /var/log/caddy/default.log
        format json
    }
    import sec_headers
}
