[Unit]
Description=Grimoire FastAPI handler (subscribe / sponsor / tools)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/grimoire
EnvironmentFile=/srv/grimoire/.env
Environment=PYTHONPATH=/srv/grimoire
ExecStart=/srv/grimoire/.venv/bin/uvicorn engine.handlers.app:app \
    --host 127.0.0.1 --port 8001 --workers 2 --log-level info \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=append:/var/log/grimoire/handler.log
StandardError=append:/var/log/grimoire/handler.log

[Install]
WantedBy=multi-user.target
