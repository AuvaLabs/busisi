[Unit]
Description=Run the monthly full Busisi reconciliation and release test suite
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/data/auvalabs/busisi
Environment=PYTHONPATH=/srv/data/auvalabs/busisi
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 ops/harness/budget_watchdog_scheduled_audit.py --cadence monthly
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/data/auvalabs/busisi/data/budget_watchdog
