{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "busisi-publication",
  "main": "src/prelaunch.js",
  "compatibility_date": "2026-11-02",
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "busisi-publication",
      "database_id": "506a96f9-03a3-47f5-8f86-dd3b6c7d1f2c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROJECT_MEDIA",
      "bucket_name": "busisi-project-evidence"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "routes": [
    { "pattern": "busisi.org", "custom_domain": true },
    { "pattern": "www.busisi.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
