# Grimoire shared infrastructure — Tier-B secrets.
# Copy to .env on the server (mode 600). NEVER commit.

POSTGRES_USER=grimoire
POSTGRES_PASSWORD=replace-with-strong-random-32+
POSTGRES_DB=grimoire
TZ=UTC

# LLM provider — OpenAI-compatible /v1/chat/completions endpoint.
# Featherless (R2 default, $25/mo Premium = 4 concurrency units, 32K context):
# LLM_PROVIDER=featherless
# LLM_BASE_URL=https://api.featherless.ai/v1
# LLM_API_KEYS=                                  # comma-separated for rotation
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct             # legacy fallback only;
#                                                  see llm_routing.py for the
#                                                  caller-aware registry
#
# Per-caller model overrides (R2). Resolution order:
#   LLM_MODEL__<vertical>__<caller>  → LLM_MODEL__<caller>  → built-in default
# Example: route Pass 2 narrative composition for Vested to a different model
#   without code changes:
# LLM_MODEL__vested__pass2_compose=deepseek-ai/DeepSeek-V3
#
# Daily concurrency-unit cap per vertical (R2 cost guardrail). 0 = no cap.
# LLM_DAILY_UNIT_CAP__embedding=1000
# LLM_DAILY_UNIT_CAP__vested=1000
#
# Legacy Groq config (kept for fallback; not the R2 default):
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Email transport (Phase 4)
# POSTMARK_API_TOKEN=
# RESEND_API_KEY=

# Subscriber crypto (Phase 9). Pepper for SHA256(email) lookup; Fernet
# key for recoverable email blob. Generate Fernet via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SUBSCRIBER_EMAIL_PEPPER=replace-with-strong-random-32+
# SUBSCRIBER_FERNET_KEY=

# Domain commit. Per-vertical canonical base URL. When unset, falls
# back to placeholder http://<vertical>.local. Switch to the real
# domain by uncommenting + setting these — no code edit required.
# EMBEDDING_CANONICAL_BASE=https://embedding.report
# VESTED_CANONICAL_BASE=https://vested.app

# Researcher cache + budget (Phase 22h)
# RESEARCH_CACHE_TTL_DAYS=7
# EXA_DAILY_CAP=200
# EXA_API_KEY=

# R2 backup leg (ops/backup.sh). Bucket grimoire-backups is provisioned;
# operator creates a bucket-scoped API token in Cloudflare R2 dash and
# pastes the access key + secret here. Without these the backup script
# still produces local dumps but skips the R2 push silently.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional override of the default endpoint / bucket:
# R2_ENDPOINT=https://22fe4279ad540a78456e6e4c82e62a1f.r2.cloudflarestorage.com
# R2_BUCKET=grimoire-backups

# Uptime Kuma push (Phase 1 observability)
# UPTIME_PUSH_URL=https://status.auvalabs.com/api/push/<token>?status=up&msg=ok

# Cloudflare API (optional, only for one-shot ops scripts:
# cf_dns_txt.sh, cf_web_analytics.sh). The token is Tier-A and
# typically lives in ~/kb_center/server_credentials.md on the command
# center, NOT in /srv/grimoire/.env on the VPS. Listed here for
# discoverability when running the ops scripts manually.
# CF_API_TOKEN=
# CF_ACCOUNT_ID=22fe4279ad540a78456e6e4c82e62a1f
