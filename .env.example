# Grimoire shared infrastructure — Tier-B secrets.
# Copy to .env on the server (mode 600). NEVER commit.

POSTGRES_USER=grimoire
POSTGRES_PASSWORD=replace-with-strong-random-32+
POSTGRES_DB=grimoire
TZ=UTC

# LLM keys (Phase 2). Comma-separated for key rotation.
# LLM_PROVIDER=groq
# LLM_API_KEYS=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=

# Email transport (Phase 4)
# POSTMARK_API_TOKEN=
# RESEND_API_KEY=

# Subscriber crypto (Phase 9). Pepper for SHA256(email) lookup; Fernet
# key for recoverable email blob. Generate Fernet via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SUBSCRIBER_EMAIL_PEPPER=replace-with-strong-random-32+
# SUBSCRIBER_FERNET_KEY=

# Domain commit. Per-vertical canonical base URL. When unset, falls
# back to placeholder http://<vertical>.local. Switch to the real
# domain by uncommenting + setting these — no code edit required.
# MODELWATCH_CANONICAL_BASE=https://modelwatch.com
# VESTED_CANONICAL_BASE=https://vested.app

# Researcher cache + budget (Phase 22h)
# RESEARCH_CACHE_TTL_DAYS=7
# EXA_DAILY_CAP=200
# EXA_API_KEY=

# R2 backup leg (ops/backup.sh). Bucket grimoire-backups is provisioned;
# operator creates a bucket-scoped API token in Cloudflare R2 dash and
# pastes the access key + secret here. Without these the backup script
# still produces local dumps but skips the R2 push silently.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional override of the default endpoint / bucket:
# R2_ENDPOINT=https://22fe4279ad540a78456e6e4c82e62a1f.r2.cloudflarestorage.com
# R2_BUCKET=grimoire-backups

# Uptime Kuma push (Phase 1 observability)
# UPTIME_PUSH_URL=https://status.auvalabs.com/api/push/<token>?status=up&msg=ok
